# ============================================================
# AGROLINGO AI — ENVIRONMENT VARIABLE REFERENCE
# Never commit real credentials. VITE_* values are public in browsers.
# ============================================================

# Frontend (Vercel project rooted at client-pwa/)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key
VITE_API_BASE_URL=https://your-agrolingo-api.up.railway.app

# Backend (Railway service rooted at this repository)
# These values are server-side secrets and must NEVER use the VITE_ prefix.
GEMINI_API_KEY=your-server-side-gemini-key
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-supabase-anon-key
ALLOWED_ORIGINS=https://agrolingo.vercel.app,http://localhost:5173
APP_ENV=production
PORT=8080

# Reserved for future server-side database administration only.
# Do not configure until a reviewed backend feature genuinely requires it.
# SUPABASE_SERVICE_ROLE_KEY=
