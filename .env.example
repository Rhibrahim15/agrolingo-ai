# ============================================================
# AGROLINGO AI — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git. This file (.env.example) is safe.
# ============================================================

# --- SUPABASE (Frontend) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- BACKEND API URL ---
# Development: http://localhost:8080
# Production:  https://your-backend.railway.app
VITE_API_BASE_URL=http://localhost:8080

# ============================================================
# SERVER (.env in /server folder)
# ============================================================

# --- SUPABASE (Backend) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
VITE_SUPABASE_KEY=your-supabase-service-role-key-here

# --- AI ---
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- WEATHER ---
VITE_OPENWEATHER_API_KEY=your-openweather-api-key-here

# --- SERVER ---
PORT=8080
APP_ENV=development
